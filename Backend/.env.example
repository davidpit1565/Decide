# The only place a model provider credential exists. Never ships in the app.
ANTHROPIC_API_KEY=sk-ant-...

# Port for the standalone server (ignored by serverless hosts).
PORT=8787

# Requests per window, per client, before the endpoint starts refusing.
DECIDE_RATE_LIMIT=20
DECIDE_RATE_WINDOW_SECONDS=60

# Optional: require this bearer token on every request. See README — on its own
# this is not a substitute for App Attest, because anything shipped inside the
# app can be extracted from it.
# DECIDE_CLIENT_TOKEN=

# Set to "1" to refuse any request that does not carry an App Attest assertion.
# The verification itself is a TODO — see src/attest.ts.
DECIDE_REQUIRE_ATTESTATION=0
