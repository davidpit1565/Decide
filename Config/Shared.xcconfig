// Shared build settings for the DECIDE app target.
//
PRODUCT_NAME = Decide
PRODUCT_BUNDLE_IDENTIFIER = com.decide.app
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
INFOPLIST_FILE = Config/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_STRICT_CONCURRENCY = complete
CODE_SIGN_STYLE = Automatic

// --- Backend and legal URLs --------------------------------------------------
// TODO(release): fill these in. They are deliberately empty rather than pointing
// at a plausible-looking host: the app treats an empty or non-HTTPS value as
// absent, so an unconfigured build says "DECIDE isn't connected yet" and hides
// the legal links, instead of failing against a domain that does not exist or
// linking to a page that was never published.
//
// A URL cannot be written literally here because "//" starts a comment, so the
// scheme is assembled below.
HTTPS = https:/$()/

DECIDE_API_HOST =
DECIDE_API_BASE_URL = $(HTTPS)$(DECIDE_API_HOST)

DECIDE_PRIVACY_POLICY_HOST =
DECIDE_PRIVACY_POLICY_URL = $(HTTPS)$(DECIDE_PRIVACY_POLICY_HOST)
DECIDE_TERMS_HOST =
DECIDE_TERMS_URL = $(HTTPS)$(DECIDE_TERMS_HOST)
DECIDE_SUPPORT_HOST =
DECIDE_SUPPORT_URL = $(HTTPS)$(DECIDE_SUPPORT_HOST)
