// Shared build settings for the DECIDE app target.
//
// A URL cannot be written literally in an xcconfig because "//" starts a comment,
// so the scheme is kept separate and joined back together below.

PRODUCT_NAME = Decide
PRODUCT_BUNDLE_IDENTIFIER = com.decide.app
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
INFOPLIST_FILE = Config/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_STRICT_CONCURRENCY = complete
CODE_SIGN_STYLE = Automatic

// --- Backend and legal URLs --------------------------------------------------
// TODO(release): replace the placeholders below with the real hosts. Every one of
// these must be HTTPS; the app ignores anything that is not.
HTTPS = https:/$()/

DECIDE_API_HOST = api.example-decide.invalid
DECIDE_API_BASE_URL = $(HTTPS)$(DECIDE_API_HOST)

DECIDE_PRIVACY_POLICY_URL = $(HTTPS)www.example-decide.invalid/privacy
DECIDE_TERMS_URL = $(HTTPS)www.example-decide.invalid/terms
DECIDE_SUPPORT_URL = $(HTTPS)www.example-decide.invalid/support
